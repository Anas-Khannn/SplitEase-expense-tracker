# Local development: backend runs on its own port.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Production (Vercel): the frontend and backend are separate Vercel projects on
# different domains, so this must be the backend's absolute URL. A relative
# "/api" only works in a single-project setup.
# NEXT_PUBLIC_API_URL=https://<backend-domain>/api
