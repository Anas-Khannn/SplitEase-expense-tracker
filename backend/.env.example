# Server
PORT=5000
NODE_ENV=development

# CORS
# Comma-separated list of allowed frontend origins, e.g.:
#   CORS_ORIGIN=https://app.example.com,https://admin.example.com
# CORS_ORIGIN is REQUIRED in production. Startup will fail if it is missing,
# empty, or whitespace-only when NODE_ENV=production.
# Development falls back to http://localhost:3000 when unset.
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=splitease_dev
DB_USER=postgres
DB_PASSWORD=your_database_password

# JWT Authentication
# JWT_SECRET is REQUIRED in production. Startup will fail if it is missing or empty when NODE_ENV=production.
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
