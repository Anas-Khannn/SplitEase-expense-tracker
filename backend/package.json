{
  "name": "splitease-backend",
  "version": "1.0.0",
  "description": "SplitEase expense tracker backend API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "lint": "eslint src __tests__ config",
    "lint:fix": "eslint src __tests__ config --fix",
    "format": "prettier --write \"src/**/*.js\" \"__tests__/**/*.js\" \"config/**/*.js\" \"eslint.config.js\" \"prettier.config.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"__tests__/**/*.js\" \"config/**/*.js\" \"eslint.config.js\" \"prettier.config.js\"",
    "docs:openapi": "node -e \"require('./src/docs/openapi').generateOpenApiSpec()\"",
    "docs:sequence": "node -e \"const spec = require('./src/docs/openapi').swaggerSpec; require('./src/docs/mermaid-sequence').generateAll(spec)\"",
    "docs:api": "npm run docs:openapi && npm run docs:sequence",
    "docs:erd": "node src/docs/generate-erd.js",
    "docs:all": "npm run docs:api && npm run docs:erd"
  },
  "keywords": [
    "splitease",
    "expense-tracker",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.4.2",
    "js-yaml": "^4.3.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./__tests__/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "verbose": true,
    "forceExit": true,
    "detectOpenHandles": true
  }
}
